{
	"name": "demo",
	"version": "5.0.6",
	"private": true,
	"type": "module",
	"devDependencies": {
		"@iwsio/fetch": "^2.1.13",
		"@iwsio/forms": "workspace:*",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/luxon": "^3.7.5",
		"@types/node": "^26.4.1",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"classnames": "^2.5.1",
		"daisyui": "^5.7.28",
		"happy-dom": "^20.14.0",
		"html-react-parser": "^6.1.7",
		"luxon": "^3.7.2",
		"markdown-it": "^15.0.1",
		"npm-run-all": "^4.1.5",
		"prismjs": "^1.30.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.1",
		"rimraf": "^6.1.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0",
		"web-vitals": "^6.2.1"
	},
	"scripts": {
		"prestart": "rimraf dist && pnpm generate",
		"start": "VITE_GITHUB_SHA=`git rev-parse HEAD` vite dev",
		"prebuild": "pnpm generate",
		"build": "vite build --mode production",
		"clean": "npm-run-all -s clean:ts clean:fs",
		"clean:ts": "tsc --build --clean",
		"clean:fs": "rimraf dist",
		"typecheck": "tsc --build",
		"lint": "biome check src",
		"test": "VITEST_SEGFAULT_RETRY=3 vitest --run --passWithNoTests",
		"pregenerate": "rimraf public/content && mkdir -p public/content",
		"generate": "node src/bin/generate.mjs",
		"serve": "serve -s -n --no-etag -l tcp://0.0.0.0:3000 -c ../serve.json ./dist"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"main": "pnpm serve",
	"author": "",
	"license": "ISC",
	"dependencies": {
		"serve": "^14.2.6"
	}
}
