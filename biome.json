{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"extends": ["@iwsio/biome-config/biome"],
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"overrides": [
		{
			"includes": ["demo/src/bin/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["demo/src/samples/**", "demo/index.html"],
			"linter": {
				"rules": {
					"a11y": {
						"noLabelWithoutControl": "off",
						"useIframeTitle": "off"
					},
					"correctness": {
						"noUnusedFunctionParameters": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/*.tsbuildinfo",
			"!demo/public/content",
			"!**/pnpm-lock.yaml"
		]
	}
}
